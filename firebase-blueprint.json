{
  "entities": {
    "OrderContract": {
      "title": "OrderContract",
      "description": "Официальный лист заказа или контракт Города",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Уникальный идентификатор заказа"
        },
        "code": {
          "type": "string",
          "description": "Официальный регистрационный код дела"
        },
        "title": {
          "type": "string",
          "description": "Название заказа"
        },
        "client": {
          "type": "string",
          "description": "Полное наименование заказчика"
        },
        "clientCategory": {
          "type": "string",
          "enum": ["association", "syndicate", "office", "individual"]
        },
        "associationName": {
          "type": "string"
        },
        "associationRole": {
          "type": "string"
        },
        "associationCode": {
          "type": "string"
        },
        "romanNumeral": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "colorHex": {
          "type": "string"
        },
        "colorRgb": {
          "type": "object",
          "properties": {
            "r": { "type": "number" },
            "g": { "type": "number" },
            "b": { "type": "number" }
          }
        },
        "watermarkUrl": {
          "type": "string"
        },
        "gradeRequirement": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "threatRating": {
          "type": "string"
        },
        "rewardAhn": {
          "type": "number"
        },
        "rewardBonus": {
          "type": "string"
        },
        "rewardRecipient": {
          "type": "string",
          "enum": ["all", "operator"]
        },
        "objective": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "conditions": {
          "type": "array"
        },
        "threats": {
          "type": "array"
        },
        "details": {
          "type": "string"
        },
        "tacticalNotes": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["available", "in_progress", "completed"]
        },
        "assignedFixer": {
          "type": "string"
        },
        "assignedOffice": {
          "type": "string"
        },
        "signedDate": {
          "type": "string"
        },
        "stampText": {
          "type": "string"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["id", "code", "title", "client", "clientCategory", "objective", "rewardAhn", "status"]
    },
    "CityDateSettings": {
      "title": "CityDateSettings",
      "description": "Глобальная настройка текущей даты Города (по умолчанию 9 июля 983 года)",
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "description": "День месяца (1-31)"
        },
        "month": {
          "type": "integer",
          "description": "Месяц (1-12)"
        },
        "year": {
          "type": "integer",
          "description": "Год по календарю Города"
        },
        "updatedAt": {
          "type": "number",
          "description": "Временная метка обновления"
        }
      },
      "required": ["day", "month", "year"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/OrderContract"
      },
      "description": "Коллекция активных официальных контрактов и листов заказов Города"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/CityDateSettings"
      },
      "description": "Настройки реестра Города (текущая дата Города в документе city_date)"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public orders board - synced for all users in real-time
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300
                    && request.resource.data.code is string
                    && request.resource.data.code.size() <= 64
                    && request.resource.data.status in ['available', 'in_progress', 'completed'];
      allow update: if request.resource.data.id is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300
                    && request.resource.data.status in ['available', 'in_progress', 'completed'];
      allow delete: if true;
    }
  }
}

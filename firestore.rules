rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: check if request is from an authenticated non-anonymous staff user
    function isStaff() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Orders registry:
    // - Read allowed to everyone (including guests in read-only mode)
    // - Create, update, and delete strictly forbidden for guests; allowed only for staff
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isStaff()
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300
                    && request.resource.data.code is string
                    && request.resource.data.code.size() <= 64;
      allow update: if isStaff()
                    && request.resource.data.id is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300;
      allow delete: if isStaff();
    }
  }
}

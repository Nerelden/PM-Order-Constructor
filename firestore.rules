rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: check if request is from an authenticated non-anonymous staff user
    function isStaff() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCityDate(data) {
      return data.keys().hasAll(['day', 'month', 'year'])
        && data.keys().hasOnly(['day', 'month', 'year', 'updatedAt'])
        && data.day is int && data.day >= 1 && data.day <= 31
        && data.month is int && data.month >= 1 && data.month <= 12
        && data.year is int && data.year >= 1 && data.year <= 99999
        && (!('updatedAt' in data) || (data.updatedAt is int && data.updatedAt >= 0));
    }

    // Orders registry:
    // - Read allowed to everyone (including guests in read-only mode)
    // - Create, update, and delete strictly forbidden for guests; allowed only for staff
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isStaff()
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300
                    && request.resource.data.code is string
                    && request.resource.data.code.size() <= 64;
      allow update: if isStaff()
                    && request.resource.data.id is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300;
      allow delete: if isStaff();
    }

    // City settings (City Date):
    // - Single-document get allowed for everyone (including guests in read-only mode)
    // - Create and update allowed only for staff with strict schema validation
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isStaff()
                    && isValidId(settingId)
                    && isValidCityDate(request.resource.data);
      allow update: if isStaff()
                    && isValidId(settingId)
                    && isValidCityDate(request.resource.data);
      allow delete: if false;
    }
  }
}
